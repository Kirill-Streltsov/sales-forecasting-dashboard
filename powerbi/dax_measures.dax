// ===========================================================================
// Sales Forecasting - DAX measures
// ---------------------------------------------------------------------------
// Semantic model:
//   Orders    fact table, one row per product line (the Superstore extract)
//   Date      date dimension, marked as a date table on [Date]
//   Forecast  the Prophet output loaded from outputs/forecast.csv
//
// These measures mirror forecasting/features.py one-for-one, so the Power BI
// report and the Streamlit app report identical numbers.
// ===========================================================================


// --- core sales / profit ---------------------------------------------------

Total Sales = SUM ( Orders[Sales] )

Total Profit = SUM ( Orders[Profit] )

Total Quantity = SUM ( Orders[Quantity] )

Profit Margin = DIVIDE ( [Total Profit], [Total Sales] )


// --- orders ----------------------------------------------------------------
// One order usually spans several product rows, so the order count is a
// distinct count of the order id rather than a row count.

Orders = DISTINCTCOUNT ( Orders[Order ID] )

Avg Order Value = DIVIDE ( [Total Sales], [Orders] )


// --- year over year --------------------------------------------------------
// Needs the Date table marked as a date table so the time-intelligence
// functions have a contiguous calendar to work with.

Sales PY =
    CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )

Sales YoY = [Total Sales] - [Sales PY]

Sales YoY % = DIVIDE ( [Sales YoY], [Sales PY] )


// --- forecast --------------------------------------------------------------
// The Forecast table carries the whole fitted line; is_forecast = TRUE marks
// the three-month horizon beyond the last actual. yhat_lower / yhat_upper are
// the bounds of the 90% confidence interval.
//
// It also stacks one Prophet run per slice: every region x category pair plus
// the "All" roll-ups (20 slices, see scripts/train_forecast.py). Summed as is,
// each day would be counted about four times, so every forecast measure keeps
// only the slice matching what is selected on Orders - by a slicer or by the
// Region manager role - and falls back to the "All" roll-up when nothing (or
// everything) is selected. The selection is read with the Date filter removed,
// because future dates have no Orders rows to read it from.
// The counts 4 and 3 are the number of regions and categories
// (config.REGIONS / config.CATEGORIES in the Python package).
//
// Summing yhat_lower / yhat_upper over several days or slices gives a band that
// is wider than the true interval of the total; read them per day.

Forecast Sales =
    VAR Regions = CALCULATETABLE ( VALUES ( Orders[Region] ), REMOVEFILTERS ( 'Date' ) )
    VAR Categories = CALCULATETABLE ( VALUES ( Orders[Category] ), REMOVEFILTERS ( 'Date' ) )
    VAR AllRegions = COUNTROWS ( Regions ) = 4
    VAR AllCategories = COUNTROWS ( Categories ) = 3
    RETURN
        CALCULATE (
            SUM ( Forecast[yhat] ),
            Forecast[is_forecast] = TRUE (),
            FILTER (
                ALL ( Forecast[region] ),
                IF ( AllRegions, Forecast[region] = "All", Forecast[region] IN Regions )
            ),
            FILTER (
                ALL ( Forecast[category] ),
                IF ( AllCategories, Forecast[category] = "All", Forecast[category] IN Categories )
            )
        )

Forecast Lower =
    VAR Regions = CALCULATETABLE ( VALUES ( Orders[Region] ), REMOVEFILTERS ( 'Date' ) )
    VAR Categories = CALCULATETABLE ( VALUES ( Orders[Category] ), REMOVEFILTERS ( 'Date' ) )
    VAR AllRegions = COUNTROWS ( Regions ) = 4
    VAR AllCategories = COUNTROWS ( Categories ) = 3
    RETURN
        CALCULATE (
            SUM ( Forecast[yhat_lower] ),
            Forecast[is_forecast] = TRUE (),
            FILTER (
                ALL ( Forecast[region] ),
                IF ( AllRegions, Forecast[region] = "All", Forecast[region] IN Regions )
            ),
            FILTER (
                ALL ( Forecast[category] ),
                IF ( AllCategories, Forecast[category] = "All", Forecast[category] IN Categories )
            )
        )

Forecast Upper =
    VAR Regions = CALCULATETABLE ( VALUES ( Orders[Region] ), REMOVEFILTERS ( 'Date' ) )
    VAR Categories = CALCULATETABLE ( VALUES ( Orders[Category] ), REMOVEFILTERS ( 'Date' ) )
    VAR AllRegions = COUNTROWS ( Regions ) = 4
    VAR AllCategories = COUNTROWS ( Categories ) = 3
    RETURN
        CALCULATE (
            SUM ( Forecast[yhat_upper] ),
            Forecast[is_forecast] = TRUE (),
            FILTER (
                ALL ( Forecast[region] ),
                IF ( AllRegions, Forecast[region] = "All", Forecast[region] IN Regions )
            ),
            FILTER (
                ALL ( Forecast[category] ),
                IF ( AllCategories, Forecast[category] = "All", Forecast[category] IN Categories )
            )
        )

// One continuous line for the trend visual: actuals where we have them, the
// forecast where we do not.
Sales or Forecast =
    VAR Actual = [Total Sales]
    RETURN
        IF ( ISBLANK ( Actual ) || Actual = 0, [Forecast Sales], Actual )


// --- Date table ------------------------------------------------------------
// Calculated table; after creating it, mark it as a date table on [Date].

Date =
    ADDCOLUMNS (
        CALENDAR ( DATE ( 2015, 1, 1 ), DATE ( 2019, 3, 31 ) ),
        "Year", YEAR ( [Date] ),
        "Month", FORMAT ( [Date], "MMM" ),
        "Month No", MONTH ( [Date] ),
        "Quarter", "Q" & FORMAT ( [Date], "Q" ),
        "Year Month", FORMAT ( [Date], "YYYY-MM" )
    )


// --- row-level security ----------------------------------------------------
// Table filter DAX for the "Region manager" role, so a signed-in manager only
// ever sees their own region. Maps the signed-in user to a region through a
// small UserRegion mapping table. The same rule goes on both tables:
//
//   Orders:    [Region] =
//                  LOOKUPVALUE (
//                      UserRegion[Region],
//                      UserRegion[Email], USERPRINCIPALNAME ()
//                  )
//
//   Forecast:  [region] =
//                  LOOKUPVALUE (
//                      UserRegion[Region],
//                      UserRegion[Email], USERPRINCIPALNAME ()
//                  )
//
// The Forecast filter also hides the company-wide "All" rows from a manager;
// without it the forecast table would show every region.
